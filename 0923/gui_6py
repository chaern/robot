from tkinter import *

win = Tk()  
win.geometry("300x300")
win.title("cherry")

Label(win, text= "메뉴를 선택하세요").pack()
burger_var=IntVar()
btn_burger1=Radiobutton(win,text="햄버거", value=2, variable = burger_var)
btn_burger2=Radiobutton(win,text="치즈버거", value=3, variable = burger_var)
btn_burger3=Radiobutton(win,text="치킨버거", value=1, variable = burger_var)
btn_burger3.select()
btn_burger3.pack()
btn_burger1.pack()
btn_burger2.pack()
Label(win, text= "음료를 선택하세요").pack()
drink_var=StringVar()
drink_var.set(" ")
btn_drink1=Radiobutton(win,text="콜라",value="콜라",variable=drink_var)
#btn_drink1.select()#기본값 선택
btn_drink2=Radiobutton(win,text="사이다",value="사이다",variable=drink_var)
btn_drink1.pack()
btn_drink2.pack()
def btncmd():
    print(burger_var.get())
    print(drink_var.get())
btn=Button(win, text="클릭", command=btncmd)
btn.pack()
win.mainloop()  #창 실행